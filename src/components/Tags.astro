---
// 文章标签展示组件:渲染为一组可点击的小标签
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags">
			{tags.map((tag) => (
				<li>
					<a href={`/tags/${tag}/`}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	.tags a {
		display: inline-block;
		padding: 0.1rem 0.6rem;
		border-radius: 999px;
		background: rgba(var(--accent), 10%);
		color: rgb(var(--accent));
		font-size: 0.85rem;
		text-decoration: none;
	}
	.tags a:hover {
		background: rgba(var(--accent), 20%);
	}
</style>

---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_URL, SITE_TITLE, TWITTER_URL } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 - ${SITE_TITLE}`} description="关于本站与作者" />
		<style>
			main {
				width: 720px;
			}
			.prose {
				line-height: 1.8;
			}
			.bio {
				font-size: 1.05rem;
				line-height: 1.9;
			}
			.bio strong {
				color: rgb(var(--accent));
			}
			.prose a {
				color: rgb(var(--accent));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<h1>关于</h1>
				<p class="bio">
					这里是 <strong>Mars Build Log</strong> 👨‍🚀
				</p>
				<p class="bio">
					前腾讯开发(3年) / 前独角兽公司技术总监(10年) / 现VibeCoding全栈开发。用
					AI Coding 构建面向全球用户的工具和 SaaS,记录产品与技术开发经验。
				</p>
				<p>内容主要涵盖:</p>
				<ul>
					<li>🛠️ 项目从 0 到 1 的构建日志</li>
					<li>🧪 技术选型与踩坑记录</li>
					<li>📖 工具链、部署与自动化实践</li>
				</ul>
				<p>
					如果你对内容感兴趣,欢迎在
					<a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
				 上关注我,在
					<a href={TWITTER_URL} target="_blank" rel="noopener noreferrer">X (Twitter)</a>
				 上和我交流,或通过 <a href="/rss.xml">RSS</a> 订阅更新。
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>
